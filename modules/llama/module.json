    ],
    "pacman": [
     "cmake",
     "gcc",
     "git"
    ],
    "apk": [
     "cmake",
     "g++",
     "git",
     "make"
    ]
   },
   "options": {
    "ref": {
     "default": "master",
     "hint": "A llama.cpp tag or commit; pin one for reproducible results"
    }
   },
   "env": {
    "LLAMA_BACKEND": "metal"
   },
   "install": [
    {
     "git": "https://github.com/ggml-org/llama.cpp.git",
     "to": "llama.cpp",
     "ref": "{opt:ref}",
     "build": [
      [
       "cmake",
       "-B",
       "build",
       "-DCMAKE_BUILD_TYPE=Release",
       "-DLLAMA_CURL=OFF",
